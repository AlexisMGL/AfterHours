{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "isolatedModules": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"]
  },
  "include": ["src", "tests", "e2e", "*.ts"]
}
