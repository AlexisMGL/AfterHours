{
  "name": "blast-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An original offline-first Bomberman-inspired browser arcade game.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e && npm run build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
